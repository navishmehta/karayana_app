# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DEBUG=true
DATABASE_URL=mysql+pymysql://kirana:CHANGE_ME@127.0.0.1:3306/kirana

STORE_TIMEZONE=Asia/Kolkata
STORE_CURRENCY=INR
# First value only; the admin can rename the store later in the app.
DEFAULT_STORE_NAME="Ramesh Karayana Store"

# First admin, created by: uv run python -m app.cli seed
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Authentication: generate with `openssl rand -hex 32`. Required.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Email: "log" (local) or "smtp" (production)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Ramesh Karayana Store"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Uploaded images. MEDIA_BASE_URL must be the public address the API is reached at, plus /media.
MEDIA_DRIVER=local
MEDIA_ROOT=storage/media
MEDIA_BASE_URL=http://127.0.0.1:8000/media

# Browser origins allowed to call the API (web catalogue), JSON list
CORS_ORIGINS=[]
