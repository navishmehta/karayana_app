# Production settings. Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env.

# Your domain (DNS A record must point to this server). Customers open https://<DOMAIN>.
DOMAIN=shop.example.com

# Database passwords — long random values:  openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Login tokens — required, at least 32 characters:  openssl rand -hex 32
JWT_SECRET=

# First admin account (created by the first deploy; change the password after logging in)
ADMIN_NAME="Ramesh"
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEFAULT_STORE_NAME="Ramesh Karayana Store"

# Email for password-reset codes (any SMTP service, e.g. Brevo, Amazon SES, Gmail app password)
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@shop.example.com
MAIL_FROM_NAME="Ramesh Karayana Store"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Push notifications through Expo (Android via Firebase Cloud Messaging, iOS via APNs)
PUSH_DRIVER=expo
EXPO_PUSH_ACCESS_TOKEN=

# Same domain serves the website and the API, so no extra browser origins are needed.
CORS_ORIGINS=[]
DEBUG=false
STORE_TIMEZONE=Asia/Kolkata
WEB_CONCURRENCY=1

# Optional off-site backups with rclone (e.g. a Cloudflare R2 or Backblaze B2 remote), e.g. "r2:kirana-backups"
RCLONE_REMOTE=
